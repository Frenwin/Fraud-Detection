table r_e1_model_comparison
	lineageTag: 18ca4f95-7d4d-4249-bbbb-082b1713e7d3

	measure 'Rules Baseline AUPRC' = CALCULATE(MAX('r_e1_model_comparison'[test_auprc]), 'r_e1_model_comparison'[model] = "Rules")
		formatString: 0.000
		lineageTag: 3f46eb3a-1fb8-4efc-95a2-4e4b2fbf2ae7

	measure 'Model Color' = IF(SELECTEDVALUE('r_e1_model_comparison'[model]) = "Rules", "#c3c2b7", "#2a78d6")
