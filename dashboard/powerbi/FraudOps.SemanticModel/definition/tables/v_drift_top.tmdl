table v_drift_top
	lineageTag: 79fb42db-2dbb-4763-b93a-b15434dcdf2b

	measure 'Drift Color' = VAR p = MAX('v_drift_top'[psi]) RETURN SWITCH(TRUE(), p >= 0.25, "#d03b3b", p >= 0.10, "#fab219", "#0ca30c")
		lineageTag: 88417946-6d80-4027-87e5-a05979fc5dcf

