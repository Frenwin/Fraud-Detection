table v_kpi_current
	lineageTag: 454ac731-343e-4206-9252-5bc94d186b8c

	measure 'TPS 5m' = MAX('v_kpi_current'[tps_5m])
		formatString: 0.0
		lineageTag: e6d7e116-4941-4b9a-a226-8bbc2f3dd588

	measure 'P50 Latency 5m (ms)' = MAX('v_kpi_current'[p50_latency_ms_5m])
		formatString: 0.00
		lineageTag: a0f18a0f-bb27-46e1-a34c-fd8bff5034d4

	measure 'P99 Latency 5m (ms)' = MAX('v_kpi_current'[p99_latency_ms_5m])
		formatString: 0.00
		lineageTag: 5dea9e70-7c46-4f00-a4e7-5ff504a50824

	measure 'SLO p99 (ms)' = 15
		formatString: 0
		lineageTag: f761e896-6fab-45aa-965c-4ba22cebdd8d

	measure 'Gauge Max (ms)' = 20
		formatString: 0
		lineageTag: 26830518-6d76-4289-9444-d83aa0259de6

	measure 'Latency Color' = IF([P99 Latency 5m (ms)] <= [SLO p99 (ms)], "#0ca30c", "#d03b3b")
		lineageTag: 39f0b720-9a2b-495a-913b-40f5e2980996

	measure 'Latency Status' = IF([P99 Latency 5m (ms)] <= [SLO p99 (ms)], "✓ Dalam SLO", "✕ Melewati SLO")
		lineageTag: c71a29b6-ed52-466f-bb9b-39db59554cc2

	measure 'Model Version' = SELECTEDVALUE('v_kpi_current'[model_version], "-")
		lineageTag: 7ebaf3c1-3b76-4196-a5fe-4a4c89b20f2f

	column tps_5m
