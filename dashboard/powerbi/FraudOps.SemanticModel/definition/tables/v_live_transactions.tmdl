table v_live_transactions
	lineageTag: d6ca76f5-8d75-4f6c-a85d-d5c95430ee7d

	measure 'Total Transactions' = COUNTROWS('v_live_transactions')
		formatString: #,0
		lineageTag: cbdf570f-b005-4a85-9d6f-84e51c2945fe

	measure Alerts = SUM('v_live_transactions'[is_alert])
		formatString: #,0
		lineageTag: 4ed07485-0fb5-420a-bb60-161fd44c09d7

	measure Blocks = SUM('v_live_transactions'[is_block])
		formatString: #,0
		lineageTag: cb143a66-a4b9-4eac-afb5-65252be920c9

	measure 'Alert Rate' = DIVIDE([Alerts], [Total Transactions])
		formatString: 0.00%
		lineageTag: b6bab3f3-68f0-4e55-8464-d3b6107a5ddf

	measure 'Block Rate' = DIVIDE([Blocks], [Total Transactions])
		formatString: 0.00%
		lineageTag: 4536e53f-6fdd-4d06-9346-5d3844fa3cb5

	measure 'Labeled Transactions' = CALCULATE([Total Transactions], NOT ISBLANK('v_live_transactions'[is_fraud]))
		formatString: #,0
		lineageTag: 60ef6b2d-f5db-4d3e-bc72-03d6bf897040

	measure 'Fraud Confirmed' = CALCULATE([Total Transactions], 'v_live_transactions'[is_fraud] = 1)
		formatString: #,0
		lineageTag: a571a818-1b30-497d-8cb6-9462acf80e7b

	measure 'Fraud Caught' = CALCULATE([Total Transactions], 'v_live_transactions'[is_fraud] = 1, 'v_live_transactions'[is_alert] = 1)
		formatString: #,0
		lineageTag: e9c74dd0-8c09-4dd5-9f9f-cd0bd2d77bdc

	measure 'False Positives' = CALCULATE([Total Transactions], 'v_live_transactions'[is_fraud] = 0, 'v_live_transactions'[is_alert] = 1)
		formatString: #,0
		lineageTag: 153db2a6-f43d-4f6e-9b32-41ad35be1036

	measure Precision = DIVIDE([Fraud Caught], CALCULATE([Alerts], NOT ISBLANK('v_live_transactions'[is_fraud])))
		formatString: 0.0%
		lineageTag: d485cb74-784d-482f-a031-43a1ddcc8b64

	measure Recall = DIVIDE([Fraud Caught], [Fraud Confirmed])
		formatString: 0.0%
		lineageTag: 759ea444-473f-47db-8128-8af8eefab3fa

	measure 'Label Coverage' = DIVIDE([Labeled Transactions], [Total Transactions])
		formatString: 0.0%
		lineageTag: afe09449-45e0-4863-b011-a6de2659b573

	measure 'Total Amount (Rp)' = SUM('v_live_transactions'[amount_idr])
		formatString: #,0
		lineageTag: f2903216-6e6d-4d5d-a59c-8a4b8527acc6

	measure 'Fraud Amount (Rp)' = CALCULATE([Total Amount (Rp)], 'v_live_transactions'[is_fraud] = 1)
		formatString: #,0
		lineageTag: 4b4d8225-654f-4950-b332-4b56d097f170

	measure 'Fraud Intercepted (Rp)' = CALCULATE([Total Amount (Rp)], 'v_live_transactions'[is_fraud] = 1, 'v_live_transactions'[is_alert] = 1)
		formatString: #,0
		lineageTag: e1166f3b-aabf-43d0-a989-695392260f17

	measure 'Fraud Missed (Rp)' = [Fraud Amount (Rp)] - [Fraud Intercepted (Rp)]
		formatString: #,0
		lineageTag: 08876566-346e-43fb-b86f-adad9d4dae66

	measure 'Loss Prevented %' = DIVIDE([Fraud Intercepted (Rp)], [Fraud Amount (Rp)])
		formatString: 0.0%
		lineageTag: 2bc18a93-f6fb-402d-b117-ffae1ebf46d4

	measure 'Net Savings (Rp)' = [Fraud Intercepted (Rp)] - 15000 * [Alerts] - 25000 * [False Positives]
		formatString: #,0
		lineageTag: bb70e788-e8dc-45b6-9070-8146e07894fa

	measure 'Fraud Amount Label' = VAR v = [Fraud Amount (Rp)] RETURN IF(ISBLANK(v), "–", IF(ABS(v) >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.00", "id-ID") & " M", "Rp " & FORMAT(v / 1e6, "#,0.0", "id-ID") & " jt"))
		lineageTag: cbabe803-caea-471b-86bd-68590b0d916c

	measure 'Fraud Intercepted Label' = VAR v = [Fraud Intercepted (Rp)] RETURN IF(ISBLANK(v), "–", IF(ABS(v) >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.00", "id-ID") & " M", "Rp " & FORMAT(v / 1e6, "#,0.0", "id-ID") & " jt"))
		lineageTag: 79e57caa-cfd1-4464-95b3-173eec630faf

	measure 'Fraud Missed Label' = VAR v = [Fraud Missed (Rp)] RETURN IF(ISBLANK(v), "–", IF(ABS(v) >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.00", "id-ID") & " M", "Rp " & FORMAT(v / 1e6, "#,0.0", "id-ID") & " jt"))
		lineageTag: c17e9f35-67ff-4b1a-a75b-3b15ccbea05b

	measure 'Net Savings Label' = VAR v = [Net Savings (Rp)] RETURN IF(ISBLANK(v), "–", IF(ABS(v) >= 1e9, "Rp " & FORMAT(v / 1e9, "#,0.00", "id-ID") & " M", "Rp " & FORMAT(v / 1e6, "#,0.0", "id-ID") & " jt"))
		lineageTag: 65f79d5c-ed2b-443a-9232-9e745f13c406

	measure 'Last Update' = "● LIVE · update " & FORMAT(MAX('v_live_transactions'[scored_at_wib]), "HH:mm:ss") & " WIB"
		lineageTag: 69958d91-7bb0-499d-a05e-7cd6bd2e626e

