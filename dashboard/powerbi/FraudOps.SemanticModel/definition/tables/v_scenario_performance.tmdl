		summarizeBy: sum
		sourceColumn: recall

		annotation SummarizationSetBy = Automatic

	column amount_idr
		dataType: double
		formatString: #,0
		lineageTag: e695ed15-237b-4703-8d82-b34f87541084
		summarizeBy: sum
		sourceColumn: amount_idr

		annotation SummarizationSetBy = Automatic

	column amount_caught_idr
		dataType: double
		formatString: #,0
		lineageTag: c279a0db-628f-4e4b-8e7b-692305c6db23
		summarizeBy: sum
		sourceColumn: amount_caught_idr

		annotation SummarizationSetBy = Automatic

	partition v_scenario_performance = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema="public",Item="v_scenario_performance"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
