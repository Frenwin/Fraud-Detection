{
  "name": "Fraud Ops",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#6250d6",
    "#e34948"
  ],
  "background": "#ffffff",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#104281",
  "center": "#86b6ef",
  "minimum": "#cde2fb",
  "null": "#c3c2b7",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#0b0b0b"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#0b0b0b"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#52514e"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#52514e"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#e2e6ec"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
            },
            "fontSize": 11,
            "alignment": "left"
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#eef0f3"
              }
            },
            "gridlineStyle": "solid",
            "labelColor": {
              "solid": {
                "color": "#898781"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            },
            "gridlineShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#eef1f6"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#eef1f6"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false,
            "lineChartType": "linear"
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false,
            "lineChartType": "linear"
          }
        ]
      }
    }
  }
}