// =====================================================================
// Fraud Ops — DAX measures (buat di tabel 'v_live_transactions')
// Mode: DirectQuery. Semua measure di bawah dapat di-fold ke SQL PostgreSQL.
// Copy-paste satu per satu: Modeling > New measure
// =====================================================================

// ---------- Volume ----------
Total Transactions = COUNTROWS ( 'v_live_transactions' )

Total Amount (Rp) = SUM ( 'v_live_transactions'[amount_idr] )

// ---------- Alerting ----------
Alerts = SUM ( 'v_live_transactions'[is_alert] )

Blocks = SUM ( 'v_live_transactions'[is_block] )

Alert Rate = DIVIDE ( [Alerts], [Total Transactions] )

Block Rate = DIVIDE ( [Blocks], [Total Transactions] )

// ---------- Kualitas deteksi (label chargeback datang terlambat) ----------
Labeled Transactions =
    CALCULATE ( [Total Transactions], NOT ISBLANK ( 'v_live_transactions'[is_fraud] ) )

Fraud Confirmed =
    CALCULATE ( [Total Transactions], 'v_live_transactions'[is_fraud] = 1 )

Fraud Caught =
    CALCULATE ( [Total Transactions], 'v_live_transactions'[is_fraud] = 1, 'v_live_transactions'[is_alert] = 1 )

False Positives =
    CALCULATE ( [Total Transactions], 'v_live_transactions'[is_fraud] = 0, 'v_live_transactions'[is_alert] = 1 )

Precision =
    DIVIDE ( [Fraud Caught],
             CALCULATE ( [Alerts], NOT ISBLANK ( 'v_live_transactions'[is_fraud] ) ) )

Recall = DIVIDE ( [Fraud Caught], [Fraud Confirmed] )

Label Coverage = DIVIDE ( [Labeled Transactions], [Total Transactions] )

// ---------- Nilai bisnis (IDR) — sama dengan configs/config.yaml ----------
Review Cost per Alert = 15000

Friction Cost per FP = 25000

Fraud Amount Total (Rp) =
    CALCULATE ( [Total Amount (Rp)], 'v_live_transactions'[is_fraud] = 1 )

Fraud Amount Intercepted (Rp) =
    CALCULATE ( [Total Amount (Rp)], 'v_live_transactions'[is_fraud] = 1, 'v_live_transactions'[is_alert] = 1 )

Loss Prevented % = DIVIDE ( [Fraud Amount Intercepted (Rp)], [Fraud Amount Total (Rp)] )

Net Savings (Rp) =
    [Fraud Amount Intercepted (Rp)]
        - [Review Cost per Alert] * [Alerts]
        - [Friction Cost per FP] * [False Positives]

// ---------- Latensi ----------
// Persentil dihitung di PostgreSQL (view v_kpi_current / v_kpi_minute) agar tetap DirectQuery-friendly
P99 Latency 5m (ms) = MAX ( 'v_kpi_current'[p99_latency_ms_5m] )

P50 Latency 5m (ms) = MAX ( 'v_kpi_current'[p50_latency_ms_5m] )

Avg Latency (ms) = AVERAGE ( 'v_live_transactions'[latency_ms] )

TPS 5m = MAX ( 'v_kpi_current'[tps_5m] )

SLO p99 (ms) = 15

// ---------- Status & conditional formatting (pakai sebagai "Field value") ----------
Latency Status Color =
    IF ( [P99 Latency 5m (ms)] <= [SLO p99 (ms)], "#0ca30c", "#d03b3b" )

Latency Status Label =
    IF ( [P99 Latency 5m (ms)] <= [SLO p99 (ms)], "✓ SLO terpenuhi", "✕ SLO terlewati" )

Decision Color =
    SWITCH ( SELECTEDVALUE ( 'v_alert_queue'[decision] ),
             "BLOCK", "#d03b3b",
             "REVIEW", "#fab219",
             "#0ca30c" )

Drift Color =
    SWITCH ( SELECTEDVALUE ( 'v_drift_latest'[level] ),
             "significant", "#d03b3b",
             "moderate", "#fab219",
             "#0ca30c" )

Last Update = "Update terakhir " & FORMAT ( MAX ( 'v_live_transactions'[scored_at_wib] ), "HH:mm:ss" ) & " WIB"

Model Version = MAX ( 'v_kpi_current'[model_version] )
